<Window x:Class="SharePointDiff.App.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:SharePointDiff.App"
 Title="SharePoint Diff" Width="1320" Height="880" MinWidth="960" MinHeight="680"
 Background="#F5F7FA" Foreground="#172C43" FontFamily="Segoe UI" FontSize="14"
 WindowStartupLocation="CenterScreen" UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display">
 <Window.Resources>
  <local:ViewModelProxy x:Key="VmProxy" Data="{Binding}" />
  <Style x:Key="CellText" TargetType="TextBlock">
   <Setter Property="VerticalAlignment" Value="Center" /><Setter Property="Margin" Value="12,0" />
   <Setter Property="TextTrimming" Value="CharacterEllipsis" /><Setter Property="Foreground" Value="#172C43" />
  </Style>
  <Style x:Key="HeaderStyle" TargetType="DataGridColumnHeader">
   <Setter Property="Background" Value="#F0F4F8" /><Setter Property="Foreground" Value="#52657B" />
   <Setter Property="FontSize" Value="12" /><Setter Property="FontWeight" Value="SemiBold" />
   <Setter Property="Height" Value="42" /><Setter Property="Padding" Value="12,0" />
   <Setter Property="BorderThickness" Value="0,0,0,1" /><Setter Property="BorderBrush" Value="#E2E8F0" />
   <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
 </Window.Resources>
 <Grid Margin="24,20,24,18">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
   <RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
  </Grid.RowDefinitions>
  <Grid Margin="0,0,0,20">
   <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
   <Border Background="#126A70" CornerRadius="10" Width="46" Height="46" Margin="0,0,14,0" VerticalAlignment="Center">
    <TextBlock Text="SP" Foreground="White" FontWeight="Bold" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center" />
   </Border>
   <StackPanel Grid.Column="1" VerticalAlignment="Center">
    <TextBlock Text="SharePoint Diff" FontSize="27" FontWeight="SemiBold" />
    <TextBlock Text="{Binding L[Subtitle]}" Foreground="#64748B" FontSize="12" TextWrapping="Wrap" Margin="0,4,16,0" />
   </StackPanel>
   <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
    <TextBlock x:Name="LanguageLabel" Text="{Binding L[Language]}" VerticalAlignment="Center" FontSize="12" MinWidth="76" Padding="0,3,8,3" Margin="0,0,12,0" ClipToBounds="False" />
    <ComboBox Width="142" ItemsSource="{Binding Languages}" SelectedIndex="{Binding LanguageIndex}" AutomationProperties.Name="{Binding L[Language]}" />
   </StackPanel>
  </Grid>
  <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16,10" Margin="0,0,0,12">
   <StackPanel>
   <Expander Header="{Binding L[Connection]}" IsExpanded="{Binding ConnectionExpanded}" FontWeight="SemiBold">
    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="260">
     <Grid Margin="0,14,0,4" IsEnabled="{Binding NotBusy}" TextElement.FontWeight="Normal">
      <Grid.ColumnDefinitions><ColumnDefinition Width="3*" /><ColumnDefinition Width="24" /><ColumnDefinition Width="2*" /></Grid.ColumnDefinitions>
      <StackPanel>
       <TextBlock Text="{Binding L[SiteUrl]}" Style="{StaticResource Caption}" FontSize="12" />
       <TextBox Text="{Binding SiteUrl,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding L[SiteUrl]}" />
       <TextBlock Text="{Binding L[LocalFolder]}" Style="{StaticResource Caption}" FontSize="12" Margin="0,12,0,6" />
       <DockPanel><Button DockPanel.Dock="Right" Content="{Binding L[Browse]}" Command="{Binding BrowseCommand}" Margin="8,0,0,0" />
        <TextBox Text="{Binding LocalRoot,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding L[LocalFolder]}" />
       </DockPanel>
       <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
        <Button Content="{Binding L[Connect]}" Command="{Binding ConnectCommand}" Style="{StaticResource PrimaryButton}" />
        <Button Content="{Binding L[ForgetSignIn]}" Command="{Binding ForgetSignInCommand}" ToolTip="{Binding L[ForgetSignInHint]}" Margin="8,0,0,0" />
       </StackPanel>
      </StackPanel>
      <StackPanel Grid.Column="2">
       <TextBlock Text="{Binding L[Profile]}" Style="{StaticResource Caption}" FontSize="12" />
       <DockPanel><Button DockPanel.Dock="Right" Content="{Binding L[New]}" Command="{Binding AddProfileCommand}" Margin="8,0,0,0" />
        <ComboBox ItemsSource="{Binding Profiles}" DisplayMemberPath="Name" SelectedIndex="{Binding ProfileIndex}" />
       </DockPanel>
       <Expander Header="{Binding L[EditProfile]}" Margin="0,12,0,0">
        <StackPanel Margin="0,10,0,0">
         <TextBlock Text="{Binding L[ProfileName]}" Style="{StaticResource Caption}" /><TextBox Text="{Binding ProfileName,UpdateSourceTrigger=PropertyChanged}" />
         <TextBlock Text="{Binding L[TenantDomain]}" Style="{StaticResource Caption}" Margin="0,8,0,5" /><TextBox Text="{Binding Tenant,UpdateSourceTrigger=PropertyChanged}" />
         <TextBlock Text="Entra Client ID" Style="{StaticResource Caption}" Margin="0,8,0,5" /><TextBox Text="{Binding Client,UpdateSourceTrigger=PropertyChanged}" />
         <Button Content="{Binding L[SaveProfile]}" Command="{Binding SaveProfileCommand}" HorizontalAlignment="Left" Margin="0,10,0,0" />
        </StackPanel>
       </Expander>
       <TextBlock Text="{Binding L[ReadOnlyNotice]}" Foreground="#64748B" TextWrapping="Wrap" FontSize="12" Margin="0,10,0,0" />
       <CheckBox Content="{Binding L[StartWithWindows]}" IsChecked="{Binding StartWithWindows}" IsEnabled="{Binding CanToggleStartWithWindows}" Margin="0,12,0,0" FontSize="12" />
       <TextBlock Text="{Binding StartupHint}" Foreground="#64748B" TextWrapping="Wrap" FontSize="12" Margin="22,4,0,0" />
       <StackPanel Margin="22,4,0,0">
        <StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding StartupWarning}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
        <TextBlock Text="{Binding StartupWarning}" Foreground="#B54708" TextWrapping="Wrap" FontSize="12" />
        <Button Content="{Binding L[UseThisCopy]}" Command="{Binding UseThisCopyCommand}" HorizontalAlignment="Left" Margin="0,6,0,0" />
       </StackPanel>
      </StackPanel>
     </Grid>
    </ScrollViewer>
   </Expander>
   <DockPanel Margin="0,10,0,0">
    <DockPanel.Style><Style TargetType="DockPanel"><Style.Triggers><DataTrigger Binding="{Binding Libraries.Count}" Value="0"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></DockPanel.Style>
    <TextBlock DockPanel.Dock="Left" Text="{Binding L[Libraries]}" FontSize="12" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,16,0" />
    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
     <ItemsControl ItemsSource="{Binding Libraries}" IsEnabled="{Binding NotBusy}">
      <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate><DataTemplate><CheckBox Content="{Binding Title}" IsChecked="{Binding Selected}" ToolTip="{Binding Folder}" Margin="0,2,18,2" FontSize="12" /></DataTemplate></ItemsControl.ItemTemplate>
     </ItemsControl>
    </ScrollViewer>
   </DockPanel>
   </StackPanel>
  </Border>
  <ItemsControl Grid.Row="2" ItemsSource="{Binding SummaryStats}" Margin="0,0,-8,14">
   <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="6" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
   <ItemsControl.ItemTemplate><DataTemplate>
    <Border Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,0,8,0" Padding="14,10">
     <StackPanel><TextBlock Text="{Binding Value,StringFormat=N0}" FontSize="23" FontWeight="SemiBold" Foreground="{Binding Color}" />
      <TextBlock Text="{Binding Label}" Foreground="#64748B" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0" /></StackPanel>
    </Border>
   </DataTemplate></ItemsControl.ItemTemplate>
  </ItemsControl>
  <Grid Grid.Row="3" Margin="0,0,0,12">
   <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="190" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
   <Button Content="{Binding L[Compare]}" Command="{Binding ScanCommand}" Style="{StaticResource PrimaryButton}" />
   <Grid Grid.Column="1" Margin="0,0,12,0">
    <TextBox Text="{Binding Filter,UpdateSourceTrigger=PropertyChanged,Delay=200}" ToolTip="{Binding L[FilterHint]}" AutomationProperties.Name="{Binding L[FilterHint]}" />
    <TextBlock Text="{Binding L[FilterHint]}" IsHitTestVisible="False" VerticalAlignment="Center" Margin="12,0" Foreground="#64748B" FontSize="13">
     <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Filter}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
    </TextBlock>
   </Grid>
   <ComboBox Grid.Column="2" SelectedIndex="{Binding StatusFilterIndex}" Margin="0,0,12,0">
    <ComboBoxItem Content="{Binding L[AllFiles]}" /><ComboBoxItem Content="{Binding L[StatusMissingLocal]}" /><ComboBoxItem Content="{Binding L[Differences]}" />
    <ComboBoxItem Content="{Binding L[StatusLocalOnly]}" /><ComboBoxItem Content="{Binding L[NeedsAttention]}" /><ComboBoxItem Content="{Binding L[StatusMatch]}" />
    <ComboBoxItem Content="{Binding L[FilterLocallyChanged]}" />
   </ComboBox>
   <StackPanel Grid.Column="3" Orientation="Horizontal">
    <Button Content="{Binding L[SelectVisible]}" Command="{Binding SelectVisibleCommand}" /><Button Content="{Binding L[ClearVisible]}" Command="{Binding ClearVisibleCommand}" Margin="0" />
   </StackPanel>
  </Grid>
  <Grid Grid.Row="4">
   <Grid.ColumnDefinitions><ColumnDefinition Width="3*" MinWidth="470" /><ColumnDefinition Width="12" /><ColumnDefinition Width="1.1*" MinWidth="240" /></Grid.ColumnDefinitions>
   <DataGrid x:Name="FilesGrid" ItemsSource="{Binding FilesView}" SelectedItem="{Binding SelectedRow}" AutoGenerateColumns="False"
    CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="True" SelectionMode="Single"
    EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
    ScrollViewer.CanContentScroll="True" RowHeight="40" HeadersVisibility="Column" ColumnHeaderStyle="{StaticResource HeaderStyle}"
    BorderBrush="#E2E8F0" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EDF1F5" Background="White" Foreground="#172C43">
    <DataGrid.CellStyle><Style TargetType="DataGridCell">
     <Setter Property="Foreground" Value="#172C43" /><Setter Property="BorderThickness" Value="0" /><Setter Property="FocusVisualStyle" Value="{x:Null}" />
     <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#E8F5F7" /><Setter Property="Foreground" Value="#172C43" /></Trigger></Style.Triggers>
    </Style></DataGrid.CellStyle>
    <DataGrid.RowStyle><Style TargetType="DataGridRow"><Setter Property="Background" Value="White" /><Setter Property="Foreground" Value="#172C43" /><Setter Property="ToolTip" Value="{Binding Path}" /></Style></DataGrid.RowStyle>
    <DataGrid.Columns>
     <DataGridTemplateColumn Width="40" CanUserSort="False"><DataGridTemplateColumn.CellTemplate><DataTemplate>
      <CheckBox IsChecked="{Binding Selected,UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanSelect}" HorizontalAlignment="Center" VerticalAlignment="Center" />
     </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
     <DataGridTemplateColumn Header="{Binding Data.L[ColumnStatus],Source={StaticResource VmProxy}}" Width="165" SortMemberPath="Status">
      <DataGridTemplateColumn.CellTemplate><DataTemplate><Border Background="{Binding StatusBackground}" CornerRadius="4" Padding="8,4" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0">
       <TextBlock Text="{Binding Status}" Foreground="{Binding StatusColor}" FontSize="12" FontWeight="Medium" />
      </Border></DataTemplate></DataGridTemplateColumn.CellTemplate>
     </DataGridTemplateColumn>
     <DataGridTextColumn Header="{Binding Data.L[ColumnPath],Source={StaticResource VmProxy}}" Binding="{Binding Path}" ElementStyle="{StaticResource CellText}" Width="*" MinWidth="230" IsReadOnly="True" />
     <DataGridTextColumn Header="{Binding Data.L[ColumnLocal],Source={StaticResource VmProxy}}" Binding="{Binding LocalSize}" ElementStyle="{StaticResource CellText}" Width="90" IsReadOnly="True" />
     <DataGridTextColumn Header="SharePoint" Binding="{Binding RemoteSize}" ElementStyle="{StaticResource CellText}" Width="100" IsReadOnly="True" />
     <DataGridTextColumn Header="{Binding Data.L[ColumnReuse],Source={StaticResource VmProxy}}" Binding="{Binding Reuse}" ElementStyle="{StaticResource CellText}" Width="90" IsReadOnly="True" />
    </DataGrid.Columns>
   </DataGrid>
   <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" Background="Transparent" />
   <Border Grid.Column="2" Style="{StaticResource Card}">
    <DockPanel><TextBlock DockPanel.Dock="Top" Text="{Binding L[Details]}" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,14" />
     <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>
       <TextBlock Text="{Binding SelectedPath}" TextWrapping="Wrap" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,10" />
       <ItemsControl ItemsSource="{Binding MetadataItems}"><ItemsControl.ItemTemplate><DataTemplate>
        <Border BorderBrush="#EDF1F5" BorderThickness="0,0,0,1" Padding="0,10">
         <StackPanel><TextBlock Text="{Binding Label}" FontSize="11" Foreground="#64748B" TextWrapping="Wrap" />
          <TextBlock Text="{Binding Value}" FontSize="13" Foreground="#172C43" TextWrapping="Wrap" Margin="0,4,0,0" /></StackPanel>
        </Border>
       </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
       <Expander Header="{Binding L[HashDetails]}" Margin="0,16,0,0"><TextBox Text="{Binding Details,Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11" BorderThickness="0" Background="Transparent" /></Expander>
      </StackPanel>
     </ScrollViewer>
    </DockPanel>
   </Border>
  </Grid>
  <Border Grid.Row="5" Style="{StaticResource Card}" Margin="0,14,0,0" Padding="16,14">
   <StackPanel>
    <TextBlock Text="{Binding Error}" Foreground="#B42318" TextWrapping="Wrap" MaxHeight="90" Margin="0,0,0,6" />
    <Expander Header="{Binding L[TechnicalDetails]}" Margin="0,0,0,10">
     <Expander.Style><Style TargetType="Expander" BasedOn="{StaticResource {x:Type Expander}}"><Style.Triggers><DataTrigger Binding="{Binding ErrorDetail}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Expander.Style>
     <DockPanel MaxHeight="170" Margin="0,8,0,0"><Button DockPanel.Dock="Right" Content="{Binding L[CopyError]}" Command="{Binding CopyErrorCommand}" VerticalAlignment="Top" Margin="8,0,0,0" />
      <TextBox Text="{Binding ErrorDetail,Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11" />
     </DockPanel>
    </Expander>
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="265" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
     <StackPanel><TextBlock Text="{Binding L[Overwrite]}" Foreground="#64748B" FontSize="12" Margin="0,0,0,7" />
      <ComboBox SelectedIndex="{Binding ModeIndex}" IsEnabled="{Binding NotBusy}"><ComboBoxItem Content="{Binding L[KeepLocal]}" /><ComboBoxItem Content="{Binding L[SelectFiles]}" /><ComboBoxItem Content="{Binding L[ReplaceAll]}" /></ComboBox>
     </StackPanel>
     <TextBlock Grid.Column="1" Text="{Binding Estimate}" TextWrapping="Wrap" FontSize="12" LineHeight="21" VerticalAlignment="Bottom" Margin="20,0,16,1" />
     <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom">
      <Button Content="{Binding L[Apply]}" Command="{Binding ApplyCommand}" Style="{StaticResource PrimaryButton}" />
      <Button Content="{Binding L[Stop]}" Command="{Binding CancelCommand}" /><Button Content="{Binding L[Reports]}" Command="{Binding OpenReportsCommand}" Margin="0" />
     </StackPanel>
    </Grid>
    <TextBlock Text="{Binding L[BackupNotice]}" Foreground="#64748B" TextWrapping="Wrap" Margin="0,10,0,0" FontSize="11" />
    <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressPercent,Mode=OneWay}" IsIndeterminate="{Binding Indeterminate,Mode=OneWay}" Height="4" Margin="0,12,0,8" Foreground="#126A70" />
    <DockPanel><TextBlock DockPanel.Dock="Left" Text="{Binding StatusText}" FontWeight="Medium" FontSize="12" Margin="0,0,16,0" />
     <TextBlock Text="{Binding ProgressPath}" Foreground="#64748B" TextTrimming="CharacterEllipsis" FontSize="12" />
    </DockPanel>
   </StackPanel>
  </Border>
 </Grid>
</Window>
